PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kaperazzo

# Comma-separated frontend origins. Leave blank for same-origin/single-service deploys.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Bootstrap super-admin emails
ADMIN_EMAILS=conradsantos.workatonline@gmail.com

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Optional: tighten auth burst traffic in production
AUTH_RATE_LIMIT_MAX=20
